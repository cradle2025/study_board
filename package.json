{
  "name": "study-board",
  "version": "0.1.0",
  "description": "学习看板 —— 离线的课程表 + 课程笔记看板，数据全部保存在本地，不联网也能用",
  "keywords": [
    "electron",
    "timetable",
    "notes",
    "obsidian",
    "study",
    "offline-first"
  ],
  "license": "MIT",
  "private": false,
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "preview": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "verify": "npm run typecheck && npm run build",
    "smoke": "node scripts/smoke.mjs",
    "smoke:timetable": "node scripts/smoke.mjs timetable",
    "smoke:portal": "node scripts/smoke.mjs portal",
    "smoke:cards": "node scripts/smoke.mjs cards",
    "smoke:notes": "node scripts/smoke.mjs notes",
    "smoke:sync": "node scripts/smoke.mjs sync",
    "bench": "node scripts/smoke.mjs bench",
    "bench:compare": "node scripts/compare-bench.mjs",
    "icon": "node scripts/make-icon.mjs",
    "package:win": "npm run build && electron-builder --win --config electron-builder.yml",
    "package:mac": "npm run build && electron-builder --mac --config electron-builder.yml",
    "package:all": "npm run build && electron-builder --win --mac --config electron-builder.yml",
    "package:dir": "npm run build && electron-builder --dir --config electron-builder.yml",
    "audit:prod": "npm audit --omit=dev"
  },
  "dependencies": {
    "chokidar": "^5.0.0",
    "docx": "^9.7.1",
    "libheif-js": "^1.23.2"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.4",
    "@codemirror/view": "^6.43.11",
    "@lezer/highlight": "^1.2.3",
    "@tiptap/core": "^3.31.3",
    "@tiptap/extension-highlight": "^3.31.3",
    "@tiptap/extension-table": "^3.31.3",
    "@tiptap/extension-text-align": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^24.13.4",
    "@types/turndown": "^5.0.6",
    "electron": "^44.3.0",
    "electron-vite": "^5.0.0",
    "markdown-it": "^15.0.1",
    "turndown": "^7.2.4",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  }
}
